# Runtime data
incoming_messages.txt
.data/

# Local registry (contains session IDs; use config/agents.example.json as template)
config/agents.json

# Machine-specific peer allowlist (names this machine's agents; example committed)
config/peer-to-peer-allowlist.json

# Principal tokens for peer messaging (never committed)
.data/peer-auth.json

# Machine-specific boss memory (seeded from local-context.example.md)
.memory/boss/local-context.md
.memory/boss/amnesia.md
# Human personal memory (this machine's runbook)
.memory/human/

# Machine-local project workspaces (moved into the lobby by the human;
# each holds its own git repo - created by setup.mjs)
/projects/

# Local archives (human-managed, not part of the lobby repo)
.archives/

# OS junk
Thumbs.db
desktop.ini

# Brainstorm mockup artifacts
.superpowers/

# Node / build
node_modules/
dist/
web/out/
web/.next/
web/next-env.d.ts
